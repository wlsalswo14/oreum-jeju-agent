# 오름(OREUM) 설정 파일 — 이 파일을 .env 로 복사한 뒤 값을 입력하세요(install.bat 이 자동 복사).
# 실제 키는 절대 제출물·문서·화면에 노출하지 마세요. 센터 담당자만 설정합니다.
# 키 발급 방법: README.md 「AI·허브 키 발급과 설정」 참고

# ── AI(LLM) ─────────────────────────────────────────────────────────────
# OpenAI API 키 — 넣으면 AI가 질문 해석·보고서 문장·후속 질문(도구 선택)을 맡습니다.
# 없으면 같은 화면·같은 계산으로 '규칙 기반' 문장이 들어갑니다(모든 기능 동작).
OPENAI_API_KEY=

# 사용할 제공자와 모델 (기본: openai · gpt-6-luna · 추론 강도 high — 오름이 이 설정으로 검증됨)
OREUM_LLM_PROVIDER=openai
OREUM_LLM_MODEL=gpt-6-luna
# 계획(질문 해석) / 작성(보고서·후속 질문) 추론 강도: low | medium | high | xhigh
OREUM_LLM_EFFORT_PLAN=high
OREUM_LLM_EFFORT_WRITE=high

# (선택) Claude를 쓰려면: OREUM_LLM_PROVIDER=anthropic, OREUM_LLM_MODEL=claude-opus-5-5, 아래 키 입력
ANTHROPIC_API_KEY=

# AI 사용 끄기(0) / 켜기(1)
OREUM_LLM_ENABLED=1

# ── 제주데이터허브 ──────────────────────────────────────────────────────
# [선택] Open API 프로젝트 키 — 넣으면 질문한 지역·기간의 일별 유동인구(583)를 오름이 직접 조회
JEJU_HUB_PROJECT_KEY=

# ── 서버·반출 기준 ──────────────────────────────────────────────────────
OREUM_HOST=127.0.0.1
OREUM_PORT=8765
# 반출 기준 최소 셀 값(센터 정책: 10)
OREUM_MIN_CELL=10
